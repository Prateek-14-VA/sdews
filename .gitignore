# ---- Data (raw + processed kept small only) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Notebooks checkpoints ----
.ipynb_checkpoints/
notebooks/**/*.ipynb_checkpoints

# ---- Editors / OS ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db